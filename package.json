{
  "name": "the-fold-surface",
  "private": true,
  "type": "module",
  "description": "the fold \u2014 the reading/research surface of The Fold. No build step; index.html is the app. Playwright is installed only for driving the live page (drive-holodeck.mjs).",
  "scripts": {
    "serve": "python3 -m http.server 8813 --bind 127.0.0.1",
    "vendor:chat": "node vendor-chat.mjs",
    "vendor:chat:check": "node vendor-chat.mjs --check",
    "vendor:check": "node vendor-sync.mjs --check && node vendor-chat.mjs --check",
    "drive": "node drive-holodeck.mjs",
    "test:overview": "node --test holodeck-overview.test.mjs",
    "notebook": "node tools/notebook-server.mjs",
    "test:notebook": "node --test holodeck-notebook.test.mjs tests/jupyter-runtime.test.mjs",
    "test:ux": "node tests/calmer-workspace.browser.cjs",
    "test:notebook:browser": "node tests/fullscreen-notebook.browser.mjs",
    "test:notebook:pyodide": "node tests/pyodide-notebook.browser.mjs"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.12"
  }
}
