   "basis": "verse-id sutra_1.1.1 at byte 58",
   "id": "sutra_1.1.1",
   "text": "1.1.1: pramāṇa-prameya-saṃśaya-prayojana-dṛṣṭānta-siddhāntāvayava-tarka-nirṇaya-vāda-jalpa-vitaṇḍāhetvābhāsa-cchala-jāti-nigrahasthānānāmtattvajñānāt niḥśreyasādhigamaḥ\n\n{padārthoddeśasūtram}"
  },
  {
   "start": 639,
   "end": 773,
   "type": "verse",
   "basis": "verse-id sutra_1.1.2 at byte 251",
   "id": "sutra_1.1.2",
   "text": "1.1.2: duḥkhajanmapravṛttidoṣamithyājñānānām uttarottarāpāye tadanantarā pāyāt apavargaḥ\n\n{padārthoddeśasūtram}\n\n[pramāṇaprakaraṇam]"
  },
  {
   "start": 773,
   "end": 844,
   "type": "verse",
   "basis": "verse-id sutra_1.1.3 at byte 385",
   "id": "sutra_1.1.3",
   "text": "1.1.3: pratyakṣānumānopamānaśabdāḥ pramāṇāni\n\n{pramāṇa-uddeśa-sūtram}"
  },
  {
   "start": 844,
   "end": 961,
   "type": "verse",
   "basis": "verse-id sutra_1.1.4 at byte 456",
   "id": "sutra_1.1.4",
   "text": "1.1.4: indriyārthasannikarṣotpannam jñānam avyapadeśyam avyabhicāri vyavasāyātmakam pratyakṣam\n\n{pratyakṣalakṣaṇam}"
  },
  {
   "start": 961,
   "end": 1060,
   "type": "verse",
   "basis": "verse-id sutra_1.1.5 at byte 573",
   "id": "sutra_1.1.5",
   "text": "1.1.5: atha tatpūrvakaṃ trividham anumānaṃ pūrvavat śeṣavat sāmānyatodṛṣṭaṃ ca\n\n{anumānalakṣaṇam}"
  },
  {
   "start": 1060,
   "end": 1131,
   "type": "verse",
   "basis": "verse-id sutra_1.1.6 at byte 672",
   "id": "sutra_1.1.6",
   "text": "1.1.6: prasiddhasādharmyāt sādhyasādhanam upamānam\n\n{upamānalakṣaṇam}"
  },
  {
   "start": 1131,
   "end": 1175,
   "type": "verse",
   "basis": "verse-id sutra_1.1.7 at byte 743",
   "id": "sutra_1.1.7",
   "text": "1.1.7: āptopadeśaḥ śabdaḥ\n\n{śabdalakṣaṇam}"
  },
  {
   "start": 1175,
   "end": 1252,
   "type": "verse",
   "basis": "verse-id sutra_1.1.8 at byte 787",
   "id": "sutra_1.1.8",
   "text": "1.1.8: saḥ dvividhaḥ dṛṣṭādṛṣṭārthatvāt\n\n{śabdabhedaḥ}\n\n[prameyaprakaraṇam]"
  },
  {
   "start": 1252,
   "end": 1371,
   "type": "verse",
   "basis": "verse-id sutra_1.1.9 at byte 864",
   "id": "sutra_1.1.9",
   "text": "1.1.9: ātmaśarīrendriyārthabuddhimanaḥpravṛttidoṣapretyabhāvaphaladuḥkhāpavargāḥ tu prameyam\n\n{prameya-uddeśa-sūtram}"
  },
  {
   "start": 1371,
   "end": 1452,
   "type": "verse",
   "basis": "verse-id sutra_1.1.10 at byte 983",
   "id": "sutra_1.1.10",
   "text": "1.1.10: icchādveṣaprayatnasukhaduḥkhajñānāni ātmanaḥ liṅgam iti\n\n{ātmalakṣaṇam}"
  },
  {
   "start": 1452,
   "end": 1509,
   "type": "verse",
   "basis": "verse-id sutra_1.1.11 at byte 1064",
   "id": "sutra_1.1.11",
   "text": "1.1.11: ceṣṭendriyārthāśrayaḥ śarīram\n\n{śarīralakṣaṇam}"
  },
  {
   "start": 1509,
   "end": 1589,
   "type": "verse",
   "basis": "verse-id sutra_1.1.12 at byte 1121",
   "id": "sutra_1.1.12",
   "text": "1.1.12: ghrāṇarasanacakṣustvakśrotrāṇi indriyāṇi bhūtebhyaḥ\n\n{indriyalakṣaṇam}"
  },
  {
   "start": 1589,
   "end": 1659,
   "type": "verse",
   "basis": "verse-id sutra_1.1.13 at byte 1201",
   "id": "sutra_1.1.13",
   "text": "1.1.13: pṛthivī āpaḥ tejaḥ vāyuḥ ākāśam iti bhūtāni\n\n{bhūtalakṣaṇam}"
  },
  {
   "start": 1659,
   "end": 1746,
   "type": "verse",
   "basis": "verse-id sutra_1.1.14 at byte 1271",
   "id": "sutra_1.1.14",
   "text": "1.1.14: gandharasarūpasparśaśabdāḥ pṛthivyādiguṇāḥ tadarthāḥ\n\n{artha(viṣaya)lakṣaṇam}"
  },
  {
   "start": 1746,
   "end": 1817,
   "type": "verse",
   "basis": "verse-id sutra_1.1.15 at byte 1358",
   "id": "sutra_1.1.15",
   "text": "1.1.15: buddhiḥ upalabdhiḥ jñānam iti anarthāntaram\n\n{buddhilakṣaṇam}"
  },
  {
   "start": 1817,
   "end": 1880,
   "type": "verse",
   "basis": "verse-id sutra_1.1.16 at byte 1429",
   "id": "sutra_1.1.16",
   "text": "1.1.16: yugapat jñānānutpattiḥ manasaḥ liṅgam\n\n{manolakṣaṇam}"
  },
  {
   "start": 1880,
   "end": 1942,
   "type": "verse",
   "basis": "verse-id sutra_1.1.17 at byte 1492",
   "id": "sutra_1.1.17",
   "text": "1.1.17: pravṛttiḥ vāgbuddhiśarīrārambhaḥ\n\n{pravṛttilakṣaṇam}"
  },
  {
   "start": 1942,
   "end": 1993,
   "type": "verse",
   "basis": "verse-id sutra_1.1.18 at byte 1554",
   "id": "sutra_1.1.18",
   "text": "1.1.18: pravarttanālakṣaṇāḥ doṣāḥ\n\n{doṣalakṣaṇam}"
  },
  {
   "start": 1993,
   "end": 2052,
   "type": "verse",
   "basis": "verse-id sutra_1.1.19 at byte 1605",
   "id": "sutra_1.1.19",
   "text": "1.1.19: punarutpattiḥ pretyabhāvaḥ\n\n{pretyabhāvalakṣaṇam}"
  },
  {
   "start": 2052,
   "end": 2112,
   "type": "verse",
   "basis": "verse-id sutra_1.1.20 at byte 1664",
   "id": "sutra_1.1.20",
   "text": "1.1.20: pravṛttidoṣajanitaḥ arthaḥ phalam\n\n{phalalakṣaṇam}"
  },
  {
   "start": 2112,
   "end": 2163,
   "type": "verse",
   "basis": "verse-id sutra_1.1.21 at byte 1724",
   "id": "sutra_1.1.21",
   "text": "1.1.21: bādhanālakṣaṇam duḥkham\n\n{duḥkhalakṣaṇam}"
  },
  {
   "start": 2163,
   "end": 2255,
   "type": "verse",
   "basis": "verse-id sutra_1.1.22 at byte 1775",
   "id": "sutra_1.1.22",
   "text": "1.1.22: tadatyantavimokṣaḥ apavargaḥ\n\n{apavargalakṣaṇam}\n\n[nyāyapūrvāṅgalakṣaṇaprakaraṇam]"
  },
  {
   "start": 2255,
   "end": 2390,
   "type": "verse",
   "basis": "verse-id sutra_1.1.23 at byte 1867",
   "id": "sutra_1.1.23",
   "text": "1.1.23: samānānekadharmopapatteḥ vipratipatteḥ upalabdhyanupalabdhyavyavasthātaḥ ca viśeṣāpekṣaḥ vimarśaḥ saṃśayaḥ\n\n{saṃśayalakṣaṇam}"
  },
  {
   "start": 2390,
   "end": 2467,
   "type": "verse",
   "basis": "verse-id sutra_1.1.24 at byte 2002",
   "id": "sutra_1.1.24",
   "text": "1.1.24: yam artham adhikṛtya pravartate tat prayojanam\n\n{prayojanalakṣaṇam}"
  },
  {
   "start": 2467,
   "end": 2596,
   "type": "verse",
   "basis": "verse-id sutra_1.1.25 at byte 2079",
   "id": "sutra_1.1.25",
   "text": "1.1.25: laukikaparīkṣakāṇāṃ yasmin arthe buddhisāmyam saḥ dṛṣṭāntaḥ\n\n{dṛṣṭāntalakṣaṇam}\n\n[nyāyāśrayasiddhāntalakṣaṇaprakaraṇam]"
  },
  {
   "start": 2596,
   "end": 2684,
   "type": "verse",
   "basis": "verse-id sutra_1.1.26 at byte 2208",
   "id": "sutra_1.1.26",
   "text": "1.1.26: tantrādhikaraṇābhyupagamasaṃsthitiḥ siddhāntaḥ\n\n{abhyupagamasiddhāntalakṣaṇam}"
  },
  {
   "start": 2684,
   "end": 2804,
   "type": "verse",
   "basis": "verse-id sutra_1.1.27 at byte 2296",
   "id": "sutra_1.1.27",
   "text": "1.1.27: saḥ caturvidhaḥ sarvatantrapratitantrādhikaraṇābhyupagamasaṃsthityarthāntarabhāvāt\n\n{tantrabheda-uddeśasūtram}"
  },
  {
   "start": 2804,
   "end": 2913,
   "type": "verse",
   "basis": "verse-id sutra_1.1.28 at byte 2416",
   "id": "sutra_1.1.28",
   "text": "1.1.28: sarvatantrāviruddhaḥ tantre adhikṛtaḥ arthaḥ sarvatantrasiddhāntaḥ\n\n{sarvatantrasiddhānta-lakṣaṇam}"
  },
  {
   "start": 2913,
   "end": 3015,
   "type": "verse",
   "basis": "verse-id sutra_1.1.29 at byte 2525",
   "id": "sutra_1.1.29",
   "text": "1.1.29: samānatantrasiddhaḥ paratantrāsiddhaḥ pratitantrasiddhāntaḥ\n\n{pratitantrasiddhānta-lakṣaṇam}"
  },
  {
   "start": 3015,
   "end": 3113,
   "type": "verse",
   "basis": "verse-id sutra_1.1.30 at byte 2627",
   "id": "sutra_1.1.30",
   "text": "1.1.30: yatsiddhau anyaprakaraṇasiddhiḥ saḥ adhikaraṇasiddhāntaḥ\n\n{adhikaraṇasiddhānta-lakṣaṇam}"
  },
  {
   "start": 3113,
   "end": 3238,
   "type": "verse",
   "basis": "verse-id sutra_1.1.31 at byte 2725",
   "id": "sutra_1.1.31",
   "text": "1.1.31: aparīkṣitābhyupagamāt tadviśeṣaparīkṣaṇam abhyupagamasiddhāntaḥ\n\n{abhyupagamasiddhānta-lakṣaṇam}\n\n[nyāyaprakaraṇam]"
  },
  {
   "start": 3238,
   "end": 3317,
   "type": "verse",
   "basis": "verse-id sutra_1.1.32 at byte 2850",
   "id": "sutra_1.1.32",
   "text": "1.1.32: pratijñāhetūdāharaṇopanayanigamanāni avayavāḥ\n\n{avayava-uddeśasūtram}"
  },
  {
   "start": 3317,
   "end": 3371,
   "type": "verse",
   "basis": "verse-id sutra_1.1.33 at byte 2929",
   "id": "sutra_1.1.33",
   "text": "1.1.33: sādhyanirdeśaḥ pratijñā\n\n{pratijñā-lakṣaṇam}"
  },
  {
   "start": 3371,
   "end": 3438,
   "type": "verse",
   "basis": "verse-id sutra_1.1.34 at byte 2983",
   "id": "sutra_1.1.34",
   "text": "1.1.34: udāharaṇasādharmyāt sādhyasādhanaṃ hetuḥ\n\n{hetu-lakṣaṇam}"
  },
  {
   "start": 3438,
   "end": 3482,
   "type": "verse",
   "basis": "verse-id sutra_1.1.35 at byte 3050",
   "id": "sutra_1.1.35",
   "text": "1.1.35: tathā vaidharmyāt\n\n{hetu-lakṣaṇam}"
  },
  {
   "start": 3482,
   "end": 3566,
   "type": "verse",
   "basis": "verse-id sutra_1.1.36 at byte 3094",
   "id": "sutra_1.1.36",
   "text": "1.1.36: sādhyasādharmyāt taddharmabhāvī dṛṣṭāntaḥ udāharaṇam\n\n{udāharaṇa-lakṣaṇam}"
  },
  {
   "start": 3566,
   "end": 3624,
   "type": "verse",
   "basis": "verse-id sutra_1.1.37 at byte 3178",
   "id": "sutra_1.1.37",
   "text": "1.1.37: tadviparyayāt vā viparītam\n\n{udāharaṇa-lakṣaṇam}"
  },
  {
   "start": 3624,
   "end": 3726,
   "type": "verse",
   "basis": "verse-id sutra_1.1.38 at byte 3236",
   "id": "sutra_1.1.38",
   "text": "1.1.38: udāharaṇāpekṣaḥ tathā iti upasaṃhāraḥ na tathā iti vā sādhyasya upanayaḥ\n\n{upanaya-lakṣaṇam}"
  },
  {
   "start": 3726,
   "end": 3831,
   "type": "verse",
   "basis": "verse-id sutra_1.1.39 at byte 3338",
   "id": "sutra_1.1.39",
   "text": "1.1.39: hetvapadeśāt pratijñāyāḥ punarvacanam nigamanam\n\n{nigamana-lakṣaṇam}\n\n[nyāyottarāṅgaprakaraṇam]"
  },
  {
   "start": 3831,
   "end": 3924,
   "type": "verse",
   "basis": "verse-id sutra_1.1.40 at byte 3443",
   "id": "sutra_1.1.40",
   "text": "1.1.40: avijñātatatve arthe kāraṇopapattitaḥ tattvajñānārtham uhaḥ tarkaḥ\n\n{tarka-lakṣaṇam}"
  },
  {
   "start": 3924,
   "end": 4112,
   "type": "verse",
   "basis": "verse-id sutra_1.1.41 at byte 3536",
   "id": "sutra_1.1.41",
   "text": "1.1.41: vimṛśya pakṣapratipakṣābhyām arthāvadhāraṇam nirṇayaḥ\n\n{nirṇaya-lakṣaṇam}\n\n(iti nyāyasūtre prathamādhyāyasya prathamam āhnikam)\n\n(atha dvitīyam āhnikam)\n\n[kathālakṣaṇaprakaraṇam]"
  },
  {
   "start": 4112,
   "end": 4237,
   "type": "verse",
   "basis": "verse-id sutra_1.2.1 at byte 3724",
   "id": "sutra_1.2.1",
   "text": "1.2.1: pramāṇatarkasādhanopālambhaḥ siddhāntāviruddhaḥ pañcāvayavopapannaḥ pakṣapratipakṣaparigrahaḥ vādaḥ\n\n{vāda-lakṣaṇam}"
  },
  {
   "start": 4237,
   "end": 4326,
   "type": "verse",
   "basis": "verse-id sutra_1.2.2 at byte 3849",
   "id": "sutra_1.2.2",
   "text": "1.2.2: yathoktopapannaḥ chalajātinigrahasthānasādhanopālambhaḥ jalpaḥ\n\n{jalpa-lakṣaṇam}"
  },
  {
   "start": 4326,
   "end": 4414,
   "type": "verse",
   "basis": "verse-id sutra_1.2.3 at byte 3938",
   "id": "sutra_1.2.3",
   "text": "1.2.3: saḥ pratipakṣasthāpanāhīnaḥ vitaṇḍā\n\n{vitaṇḍā-lakṣaṇam}\n\n[hetvābhāsaprakaraṇam]"
  },
  {
   "start": 4414,
   "end": 4519,
   "type": "verse",
   "basis": "verse-id sutra_1.2.4 at byte 4026",
   "id": "sutra_1.2.4",
   "text": "1.2.4: savyabhicāra-viruddha-prakaraṇasama-sādhyasama-kālātītāḥ hetvābhāsāḥ\n\n{hetvābhāsa-uddeśa-sūtram}"
  },
  {
   "start": 4519,
   "end": 4579,
   "type": "verse",
   "basis": "verse-id sutra_1.2.5 at byte 4131",
   "id": "sutra_1.2.5",
   "text": "1.2.5: anaikāntikaḥ savyabhicāraḥ\n\n{savyabhicāra-lakṣaṇam}"
  },
  {
   "start": 4579,
   "end": 4651,
   "type": "verse",
   "basis": "verse-id sutra_1.2.6 at byte 4191",
   "id": "sutra_1.2.6",
   "text": "1.2.6: siddhāntam abhyupetya tadvirodhī viruddhaḥ\n\n{viruddha-lakṣaṇam}"
  },
  {
   "start": 4651,
   "end": 4748,
   "type": "verse",
   "basis": "verse-id sutra_1.2.7 at byte 4263",
   "id": "sutra_1.2.7",
   "text": "1.2.7: yasmāt prakaraṇacintā saḥ nirṇayārthamapadiṣṭaḥ prakaraṇasamaḥ\n\n{prakaraṇasama-lakṣaṇam}"
  },
  {
   "start": 4748,
   "end": 4817,
   "type": "verse",
   "basis": "verse-id sutra_1.2.8 at byte 4360",
   "id": "sutra_1.2.8",
   "text": "1.2.8: sādhyāviśiṣṭaḥ sādhyatvāt sādhyasamaḥ\n\n{sādhyasama-lakṣaṇam}"
  },
  {
   "start": 4817,
   "end": 4893,
   "type": "verse",
   "basis": "verse-id sutra_1.2.9 at byte 4429",
   "id": "sutra_1.2.9",
   "text": "1.2.9: kālātyayāpadiṣṭaḥ kālātītaḥ\n\n{kālātīta-lakṣaṇam}\n\n[chalaprakaraṇam]"
  },
  {
   "start": 4893,
   "end": 4963,
   "type": "verse",
   "basis": "verse-id sutra_1.2.10 at byte 4505",
   "id": "sutra_1.2.10",
   "text": "1.2.10: vacanavighātaḥ arthavikalpopapattyā chalam\n\n{chala-lakṣaṇam}"
  },
  {
   "start": 4963,
   "end": 5064,
   "type": "verse",
   "basis": "verse-id sutra_1.2.11 at byte 4575",
   "id": "sutra_1.2.11",
   "text": "1.2.11: tat trividham - vākchalam sāmānyacchalam upacāracchalam ca iti\n\n{chala-bheda-uddeśa-sūtram}"
  },
  {
   "start": 5064,
   "end": 5161,
   "type": "verse",
   "basis": "verse-id sutra_1.2.12 at byte 4676",
   "id": "sutra_1.2.12",
   "text": "1.2.12: aviśeṣābhihite arthe vaktuḥ abhiprāyāt arthāntarakalpanā vākchalam\n\n{vākchala-lakṣaṇam}"
  },
  {
   "start": 5161,
   "end": 5269,
   "type": "verse",
   "basis": "verse-id sutra_1.2.13 at byte 4773",
   "id": "sutra_1.2.13",
   "text": "1.2.13: sambhavataḥ arthasya atisāmānyayogāt asambhūtārthakalpanā sāmānyacchalam\n\n{sāmānyacchala-lakṣaṇam}"
  },
  {
   "start": 5269,
   "end": 5365,
   "type": "verse",
   "basis": "verse-id sutra_1.2.14 at byte 4881",
   "id": "sutra_1.2.14",
   "text": "1.2.14: dharmavikalpanirdeśe arthasadbhāvapratiṣedhaḥ upacāracchalam\n\n{upacāracchala-lakṣaṇam}"
  },
  {
   "start": 5365,
   "end": 5453,
   "type": "verse",
   "basis": "verse-id sutra_1.2.15 at byte 4977",
   "id": "sutra_1.2.15",
   "text": "1.2.15: vākchalam eva upacāracchalam tat aviśeṣāt\n\n{upacāracchala-pūrvapakṣa-lakṣaṇam}"
  },
  {
   "start": 5453,
   "end": 5512,
   "type": "verse",
