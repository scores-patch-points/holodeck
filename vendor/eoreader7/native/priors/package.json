{
  "name": "live_priors",
  "version": "1.0.0",
  "description": "Living corpus of source texts organized by the 17 categories from eoPriors",
  "type": "module",
  "scripts": {
    "fetch:all": "node scripts/run-all.mjs",
    "fetch:gutenberg": "node scripts/fetch-gutenberg.mjs",
    "fetch:wikipedia": "node scripts/fetch-wikipedia.mjs",
    "fetch:sefaria": "node scripts/fetch-sefaria.mjs",
    "fetch:quran": "node scripts/fetch-quran.mjs",
    "fetch:suttacentral": "node scripts/fetch-suttacentral.mjs",
    "fetch:greek-nt": "node scripts/fetch-greek-nt.mjs",
    "fetch:government": "node scripts/fetch-government.mjs",
    "fetch:world-government": "node scripts/fetch-world-government.mjs",
    "fetch:replacements": "node scripts/fetch-replacements.mjs",
    "catalogs": "node scripts/consolidate-media-catalogs.mjs",
    "audit": "node scripts/enforce-min-words.mjs",
    "audit:prune": "node scripts/enforce-min-words.mjs --prune",
    "fetch:shakespeare": "node scripts/fetch-shakespeare.mjs",
    "fetch:code": "node scripts/fetch-code-repos.mjs",
    "fetch:audited-code": "node scripts/fetch-audited-code.mjs",
    "vet:code": "node scripts/vet-source-code.mjs",
    "fetch:ccel": "node scripts/fetch-ccel.mjs",
    "fetch:mysticism": "node scripts/fetch-mysticism.mjs",
    "fetch:archive-media": "node scripts/fetch-archive-media.mjs",
    "fetch:childrens-books": "node scripts/fetch-childrens-books.mjs",
    "fetch:ganjoor": "node scripts/fetch-ganjoor.mjs",
    "fetch:concepticon": "node scripts/fetch-concepticon.mjs",
    "fetch:parallel-classics": "node scripts/fetch-parallel-classics.mjs",
    "fetch:sanskrit-canon": "node scripts/fetch-sanskrit-canon.mjs",
    "fetch:greek-originals": "node scripts/fetch-greek-originals.mjs",
    "fetch:latin-originals": "node scripts/fetch-latin-originals.mjs",
    "fetch:japanese-originals": "node scripts/fetch-japanese-originals.mjs",
    "fetch:arabic-originals": "node scripts/fetch-arabic-originals.mjs",
    "structure:canon": "node scripts/extract-source-structure.mjs --manifest manifests/source-structure-manifest.json 14-holy-texts/upanishads/*.txt 14-holy-texts/bhagavad-gita/*.txt 11-multi-language/sanskrit-originals/*.txt 11-multi-language/greek-originals/*.txt 11-multi-language/latin-originals/*.txt 11-multi-language/japanese-originals/*.txt 11-multi-language/arabic-originals/*.txt",
    "download:media": "node scripts/download-archive-media.mjs",
    "demo:similarity": "node scripts/demo-similarity.mjs",
    "pronunciation:build": "node scripts/build-pronunciation-prior.mjs",
    "pronunciation:serve": "node scripts/pronunciation.mjs serve",
    "pronunciation:coverage": "node scripts/pronunciation.mjs coverage",
    "pronunciation:compare": "node scripts/pronunciation-compare.mjs",
    "test:pronunciation": "node --test scripts/pronunciation.test.mjs scripts/pronunciation-compare.test.mjs",
    "stats": "find . -name '*.txt' -o -name '*.json' | grep -v node_modules | grep -v .git | wc -l && du -sh ."
  },
  "keywords": ["corpus", "texts", "priors", "eo", "gutenberg", "wikipedia", "holy-texts"],
  "license": "MIT"
}
