   "start": 27085,
   "end": 27170,
   "type": "verse",
   "basis": "verse-id tasya at byte 26704",
   "id": "tasya",
   "text": "tasya traya āvasathās trayaḥ svapnā ayam āvasatho 'yam āvasatho 'yam āvasatha iti ||"
  },
  {
   "start": 27170,
   "end": 27187,
   "type": "verse",
   "basis": "verse-id aitup_1.3.12 at byte 26789",
