  },
  {
   "start": 24752,
   "end": 25187,
   "type": "verse",
   "basis": "verse-id aitupbh_1.3.4 at byte 24371",
   "id": "aitupbh_1.3.4",
   "text": "aitupbh_1,3.4-10\n\ntatprāṇena taccakṣuṣā tacchrotreṇa tattvacā tanmanasā tacchiśnena tena tena karaṇavyāpāreṇānnaṃ grahītumaśaknuvanpaścādapānena vāyunā mukhacchidreṇa tadannamajighṛkṣat /\ntadāvayāttad"
  },
  {
   "start": 25187,
   "end": 25422,
   "type": "verse",
   "basis": "verse-id sa at byte 24806",
   "id": "sa",
   "text": "sa īkṣata katareṇa prapadyā iti | sa īkṣata yadi vācābhivyāhṛtaṃ yadi prāṇenābhiprāṇitaṃ yadi cakṣuṣā dṛṣṭaṃ yadi śrotreṇa śrutaṃ yadi tvacā spṛṣṭaṃ yadi manasā dhyātaṃ yady apānenābhyapānitaṃ yadi śi"
  },
  {
   "start": 25422,
   "end": 25439,
