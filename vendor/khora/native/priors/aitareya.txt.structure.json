   "start": 39841,
   "end": 39883,
   "type": "verse",
   "basis": "verse-id sāsyaitam at byte 39460",
   "id": "sāsyaitam",
   "text": "sāsyaitam ātmānam atra gataṃ bhāvayati ||"
  },
  {
   "start": 39883,
   "end": 39897,
   "type": "verse",
   "basis": "verse-id aitup_2.2 at byte 39502",
   "id": "aitup_2.2",
   "text": "aitup_2.2 ||"
  },
  {
   "start": 39897,
   "end": 40418,
   "type": "verse",
   "basis": "verse-id aitupbh_2.2 at byte 39516",
   "id": "aitupbh_2.2",
   "text": "aitupbh_2.2\n\ntadreto yasyāṃ striyāṃ siktaṃ sattasyā ātmabhūyamātmāvyatirekatāṃ yathā piturevaṃ gacchati prāpnoti yathā svamaṅgaṃ stanādi tathā tadvadeva / tasmāddhetorenāṃ mātaraṃ sa garbho na hinasti"
  },
  {
   "start": 40418,
   "end": 40446,
   "type": "verse",
   "basis": "verse-id taṃ at byte 40037",
   "id": "taṃ",
   "text": "taṃ strī garbhaṃ bibharti |"
  },
  {
   "start": 40446,
   "end": 40496,
   "type": "verse",
   "basis": "verse-id so at byte 40065",
   "id": "so",
   "text": "so 'gra eva kumāraṃ janmano 'gre 'dhi bhāvayati |"
  },
  {
   "start": 40496,
   "end": 40590,
   "type": "verse",
   "basis": "verse-id sa at byte 40115",
   "id": "sa",
   "text": "sa yat kumāraṃ janmano 'gre 'dhi bhāvayaty ātmānam eva tad bhāvayaty eṣāṃ lokānāṃ santatyai |"
  },
  {
