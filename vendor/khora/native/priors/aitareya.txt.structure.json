   "basis": "verse-id saiṣā at byte 26658",
   "id": "saiṣā",
   "text": "saiṣā vidṛtir nāma dvāḥ |"
  },
  {
   "start": 27065,
   "end": 27085,
   "type": "verse",
   "basis": "verse-id tad at byte 26684",
   "id": "tad",
   "text": "tad etan nāndanam |"
  },
