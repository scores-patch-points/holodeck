   "type": "verse",
   "basis": "verse-id athāsyāyam at byte 41399",
   "id": "athāsyāyam",
   "text": "athāsyāyam itara ātmā kṛtakṛtyo vayogataḥ praiti |"
  },
  {
   "start": 41831,
   "end": 41866,
   "type": "verse",
   "basis": "verse-id sa at byte 41450",
   "id": "sa",
   "text": "sa itaḥ prayann eva punar jāyate |"
