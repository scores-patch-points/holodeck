  },
  {
   "start": 25439,
   "end": 27039,
   "type": "verse",
   "basis": "verse-id aitupbh_1.3.11 at byte 25058",
   "id": "aitupbh_1.3.11",
   "text": "aitupbh_1,3.11\n\nsa evaṃ lokalokapālasaṃghātasthitimannanimittaṃ kṛtvā purapauratatpālayita sthitisamāṃ svāmīva īkṣata - kathaṃ nu kena prakāreṇeti vitarkayannidaṃ madṛte māmantareṇa purasvāminam, yadi"
  },
