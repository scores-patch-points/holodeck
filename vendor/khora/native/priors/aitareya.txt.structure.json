   "text": "aitup_1,3.12 ||"
  },
  {
   "start": 27187,
   "end": 28541,
   "type": "verse",
   "basis": "verse-id aitupbh_1.3.12 at byte 26806",
   "id": "aitupbh_1.3.12",
   "text": "aitupbh_1,3.12\n\nsa iṣṭeśvara etameva mūrdhasīmānaṃ keśavibhāgāvasānaṃ vidārya cchidrīkṛtvaitayā dvārā mārgeṇemaṃ lokaṃ kāryakaraṇasaṃghātaṃ prāpadyata praviveśa / seyaṃ hi prasiddhā dvāḥ mūrdhni tailā"
  },
  {
   "start": 28541,
   "end": 28606,
   "type": "verse",
   "basis": "verse-id sa at byte 28160",
   "id": "sa",
   "text": "sa etam eva puruṣaṃ brahma tatamam apaśyad idam adarśam itī 3 ||"
  },
  {
   "start": 28606,
   "end": 28623,
   "type": "verse",
   "basis": "verse-id aitup_1.3.13 at byte 28225",
   "id": "aitup_1.3.13",
   "text": "aitup_1,3.13 ||"
  },
  {
   "start": 28623,
   "end": 29211,
