   "text": "tad asya tṛtīyaṃ janma ||"
  },
  {
   "start": 41892,
   "end": 41906,
   "type": "verse",
   "basis": "verse-id aitup_2.4 at byte 41511",
   "id": "aitup_2.4",
   "text": "aitup_2.4 ||"
  },
  {
   "start": 41906,
   "end": 43273,
   "type": "verse",
   "basis": "verse-id aitupbh_2.4 at byte 41525",
   "id": "aitupbh_2.4",
   "text": "aitupbh_2.4\n\nasya pituḥ so 'yaṃ putrātmā puṇyebhyaḥ śāstroktebhyaḥ karmabhyaḥ karmaniṣpādanārthaṃ pratidhīyate pituḥ sthāne pitrā yatkartavyaṃ tatkaraṇāya pratinidhīyata ityarthaḥ / tathā ca saṃpratti"
  },
