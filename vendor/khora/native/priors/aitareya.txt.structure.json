   "basis": "verse-id idandro at byte 28830",
   "id": "idandro",
   "text": "idandro ha vai nāma |"
  },
  {
   "start": 29233,
   "end": 29284,
   "type": "verse",
   "basis": "verse-id tam at byte 28852",
   "id": "tam",
   "text": "tam idandraṃ santam indra ity ācakṣate parokṣeṇa |"
  },
  {
   "start": 29284,
   "end": 29339,
   "type": "verse",
   "basis": "verse-id parokṣapriy at byte 28903",
   "id": "parokṣapriy",
   "text": "parokṣapriyā iva hi devāḥ parokṣapriyā iva hi devāḥ ||"
  },
  {
   "start": 29339,
   "end": 29356,
   "type": "verse",
   "basis": "verse-id aitup_1.3.14 at byte 28958",
   "id": "aitup_1.3.14",
   "text": "aitup_1,3.14 ||"
  },
  {
   "start": 29356,
   "end": 38775,
   "type": "verse",
   "basis": "verse-id aitupbh_1.3.14 at byte 28975",
   "id": "aitupbh_1.3.14",
   "text": "aitupbh_1,3.14\n\ntasmādidaṃ paśyatītīdandro nāma paramātmā / idandro ha vai nāma prasiddho loka īśvaraḥ / tamevamidandraṃ santamindra iti parokṣeṇa parokṣābhidhānenācakṣate brahmavidaḥ saṃvyavahārārtha"
  },
  {
   "start": 38775,
   "end": 38921,
   "type": "verse",
   "basis": "verse-id tad at byte 38394",
   "id": "tad",
   "text": "tad etat sarvebhyo 'ṅgebhyas tejaḥ sambhūtam ātmany evātmānaṃ bibharti | tad yadā striyāṃ siñcaty athainaj janayati | tad asya prathamaṃ janma ||"
  },
  {
   "start": 38921,
   "end": 38935,
   "type": "verse",
   "basis": "verse-id aitup_2.1 at byte 38540",
   "id": "aitup_2.1",
   "text": "aitup_2.1 ||"
  },
  {
   "start": 38935,
   "end": 39816,
   "type": "verse",
   "basis": "verse-id aitupbh_2.1 at byte 38554",
   "id": "aitupbh_2.1",
   "text": "aitupbh_2.1\n\nayamevāvidyākāmakarmābhimānavān yajñādikarma kṛtvāsmāllokād dhūmādikrameṇa annabhūtaḥ puruṣāgnau hutaḥ / tasminpuruṣe ha vā ayaṃ saṃsārī rasādikrameṇa āditaḥ prathamato retorūpeṇa garbho "
  },
  {
