   "end": 43385,
   "type": "verse",
   "basis": "verse-id garbha at byte 42958",
   "id": "garbha",
   "text": "garbha evaitac chayāno vāmadeva evam uvāca ||"
  },
  {
   "start": 43385,
   "end": 43399,
   "type": "verse",
