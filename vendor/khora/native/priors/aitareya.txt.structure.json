   "basis": "verse-id śataṃ at byte 42892",
   "id": "śataṃ",
   "text": "śataṃ mā pura āyasīr arakṣannadha śyeno javasā nir adīyam |"
  },
  {
   "start": 43333,
   "end": 43339,
   "type": "verse",
   "basis": "verse-id iti at byte 42952",
   "id": "iti",
