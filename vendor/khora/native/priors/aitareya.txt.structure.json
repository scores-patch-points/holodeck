   "type": "verse",
   "basis": "verse-id tad at byte 40235",
   "id": "tad",
   "text": "tad asya dvitīyaṃ janma ||"
  },
  {
   "start": 40643,
   "end": 40657,
   "type": "verse",
   "basis": "verse-id aitup_2.3 at byte 40262",
   "id": "aitup_2.3",
   "text": "aitup_2.3 ||"
  },
  {
   "start": 40657,
   "end": 41780,
   "type": "verse",
   "basis": "verse-id aitupbh_2.3 at byte 40276",
   "id": "aitupbh_2.3",
   "text": "aitupbh_2.3\n\nsā bhāvayitrī vardhayitrī bharturātmano garbhabhūtasya bhāvayitavyā vardhayitavyā rakṣayitavyā ca bhartā bhavati / na hyupakārapratyupakāramantareṇa loke kasyacitkenacitsambandha upapadya"
  },
  {
